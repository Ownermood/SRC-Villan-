# Easiest: run  python -m tgclone setup  and it fills this file for you.

# from https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# from @BotFather -> /newbot
BOT_TOKEN=
# your Telegram user id (from @userinfobot) - gets the 🛡 Admin panel
OWNER_ID=
# encrypts users' saved logins. Generated by setup. Back it up! (empty = data/secret.key)
SECRET_KEY=

# ---- optional / advanced ----
# old single-user mode: your own session (users normally log in inside the bot instead)
SESSION_STRING=
# TGCLONE_CONFIG=tgclone.config.json
# TGCLONE_DATA=data
